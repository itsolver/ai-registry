{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.itsolver.au/schema/model-registry.schema.json",
  "title": "IT Solver AI Model Registry",
  "type": "object",
  "required": ["version", "updated_at", "models"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "anyOf": [
          { "$ref": "#/$defs/providerTiers" },
          { "$ref": "#/$defs/logicalModel" }
        ]
      }
    }
  },
  "$defs": {
    "providerTiers": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          { "type": "string", "minLength": 1 },
          { "$ref": "#/$defs/modelEntry" }
        ]
      }
    },
    "logicalModel": {
      "anyOf": [
        { "$ref": "#/$defs/modelEntryWithProvider" },
        {
          "type": "object",
          "required": ["fallbacks"],
          "additionalProperties": false,
          "properties": {
            "fallbacks": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/modelEntryWithProvider" }
            }
          }
        }
      ]
    },
    "modelEntry": {
      "type": "object",
      "required": ["model"],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "modelEntryWithProvider": {
      "type": "object",
      "required": ["provider", "model"],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": ["GEMINI", "OPENAI", "XAI"]
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
